# Copy this file to .env and fill in real values. Never commit .env.

# Application display name.
APP_NAME=Expense Claim Workflow API

# Anthropic API key used by the backend to call Claude.
ANTHROPIC_API_KEY=your_real_key_here

# Claude model identifier used for requests.
CLAUDE_MODEL=claude-sonnet-4-6

# Maximum time, in seconds, to wait for a Claude request.
CLAUDE_TIMEOUT_SECONDS=30

# Number of times the SDK retries a failed Claude request.
CLAUDE_MAX_RETRIES=2

# MongoDB connection string and database name.
MONGODB_URI=mongodb://YOUR_DB_USER:YOUR_PASSWORD@localhost:27017/YOUR_DB?authSource=YOUR_DB
MONGODB_DATABASE=expense_claims

LOG_LEVEL=INFO
